{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/mcp",
      "has": [
        {
          "type": "host",
          "value": "mcp.anlim.ai"
        }
      ],
      "destination": "https://zejyuxnuzmvlcbpfklrg.supabase.co/functions/v1/studio-mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "has": [
        {
          "type": "host",
          "value": "mcp.anlim.ai"
        }
      ],
      "destination": "https://zejyuxnuzmvlcbpfklrg.supabase.co/functions/v1/studio-mcp/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "has": [
        {
          "type": "host",
          "value": "mcp.anlim.ai"
        }
      ],
      "destination": "https://zejyuxnuzmvlcbpfklrg.supabase.co/functions/v1/studio-mcp/.well-known/oauth-protected-resource"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://zejyuxnuzmvlcbpfklrg.supabase.co; media-src 'self' blob: https://zejyuxnuzmvlcbpfklrg.supabase.co https://storage.googleapis.com https://*.elevenlabs.io; connect-src 'self' https://zejyuxnuzmvlcbpfklrg.supabase.co wss://zejyuxnuzmvlcbpfklrg.supabase.co https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
